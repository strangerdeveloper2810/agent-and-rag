# ==========================================
# J.A.R.V.I.S. — Environment Configuration
# ==========================================
# Copy file này thành .env và điền giá trị thật.
# cp .env.example .env

# --- Server ---
PORT=3002

# --- LLM Provider ---
# Chọn 1 trong: gemini | anthropic | ollama
LLM_PROVIDER=gemini

# Gemini (Google AI)
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Thinking level: OFF | LOW | MEDIUM | HIGH. OFF = nhanh nhất.
GOOGLE_THINKING_LEVEL=OFF

# Anthropic (Claude)
# Lấy key tại: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Ollama (local LLM — không cần API key)
# Cài đặt: brew install ollama && ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Storage ---
# SQLite database path. Để trống = jarvis.db (current directory)
JARVIS_DB_PATH=jarvis.db
# Skills directory
JARVIS_SKILLS_DIR=./skills

# --- Embedding (cho RAG + Memory vector search) ---
# Dùng Ollama embedding (local, free) hoặc Voyage AI (cloud)
EMBED_MODEL=nomic-embed-text
VOYAGE_API_KEY=your_voyage_api_key_here

# --- Limits ---
# Không cần set, dùng default:
# MAX_STEPS=12        # max agent loop iterations
# MAX_TOOL_OUTPUT=24000  # max chars from tool
# SHELL_TIMEOUT=30    # seconds
