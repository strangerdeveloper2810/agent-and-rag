{
  "name": "ai-agent-tut",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@app/api",
    "dev:web": "turbo run dev --filter=@app/web",
    "build": "turbo run build",
    "start": "turbo run start --filter=@app/api",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "rm -rf .turbo apps/*/dist apps/*/.turbo node_modules apps/*/node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
