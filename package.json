{
  "name": "ai-agent-tut",
  "version": "0.2.0",
  "private": true,
  "description": "J.A.R.V.I.S. — AI Agent Runtime (Go) + Gateway (Fastify/TS) + Frontend (React)",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:go": "cd services/agent-go && go run ./cmd/server",
    "dev:api": "turbo run dev --filter=@app/api",
    "dev:web": "turbo run dev --filter=@app/web",
    "build": "turbo run build",
    "build:go": "cd services/agent-go && go build -ldflags='-s -w' -o bin/server ./cmd/server",
    "build:api": "turbo run build --filter=@app/api",
    "build:web": "turbo run build --filter=@app/web",
    "start": "cd services/agent-go && ./bin/server",
    "start:api": "turbo run start --filter=@app/api",
    "test": "turbo run test",
    "test:go": "cd services/agent-go && go test ./... -race -count=1",
    "test:api": "turbo run test --filter=@app/api",
    "test:web": "turbo run test --filter=@app/web",
    "test:all": "turbo run test && cd services/agent-go && go test ./... -race -count=1",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:go": "cd services/agent-go && go vet ./...",
    "lint:all": "turbo run lint && cd services/agent-go && go vet ./...",
    "fmt": "prettier --write . && cd services/agent-go && gofmt -w .",
    "fmt:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf services/agent-go/bin/ services/agent-go/coverage.*",
    "setup": "pnpm install && cd services/agent-go && go mod download",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
