# =============================================================================
# J.A.R.V.I.S. — Production Environment Template
# =============================================================================
# Copy: cp env/.env.example env/.env
# Điền giá trị thật trước khi deploy.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.xxx.mongodb.net/ai_agent_tut

# PostgreSQL
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ai_agent_tut
# host=postgres vì trong Docker network
PG_CONNECTION_STRING=postgresql://jarvis:change-me-in-production@postgres:5432/ai_agent_tut

# Redis
# host=redis vì trong Docker network
REDIS_URL=redis://redis:6379/0

# ── AI Provider: Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── AI Provider: Google (optional) ───────────────────────────────────────────
LLM_PROVIDER=auto
GOOGLE_API_KEY=AIza...
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_THINKING_LEVEL=LOW

# ── AI Provider: DeepSeek (cheap immediate fallback) ──────────────────────────
# DeepSeek API key: https://platform.deepseek.com/api_keys
# Cực kỳ rẻ (~1/10 Gemini, ~1/50 Claude) — secondary provider lý tưởng
# Flash: task đơn giản (chat, hỏi đáp nhanh) — siêu rẻ + siêu nhanh
# Pro:   task cần reasoning (multi-step agent, tool calling, phân tích)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# ── Embedding ────────────────────────────────────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── Auth: JWT ────────────────────────────────────────────────────────────────
# Dùng `openssl rand -hex 32` để tạo secret đủ 32+ ký tự.
JWT_SECRET=replace-with-at-least-32-char-random-string
JWT_REFRESH_SECRET=replace-with-at-least-32-char-random-string

# ── Auth: Google OAuth ───────────────────────────────────────────────────────
# Lấy tại https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# ── Agent Backend ────────────────────────────────────────────────────────────
AGENT_BACKEND=go
AGENT_GO_URL=http://agent-go:3002
AGENT_GO_TIMEOUT=120000

# ── Go Agent ─────────────────────────────────────────────────────────────────
JARVIS_DB_PATH=/data/jarvis.db
JARVIS_SKILLS_DIR=/skills
EMBED_MODEL=nomic-embed-text
MONGODB_DB=ai_agent_tut
# ENABLE_PLANNING=true để bật LLM plan node (tốn thêm 1 LLM call trước token đầu)
ENABLE_PLANNING=false
# ALLOW_DESTRUCTIVE_TOOLS=true cho phép agent TỰ CHẠY tool destructive
# (hiện chỉ có shell.exec) mà không cần xác nhận.
# ⚠ Đây là quyền chạy lệnh shell tuỳ ý trên máy chạy agent — CHỈ bật trên máy
# cá nhân khi bạn chủ động muốn. Khi tắt (mặc định), agent sẽ trả về thông báo
# giải thích tool nào bị chặn và cách xử lý, thay vì câu trả lời rỗng.
ALLOW_DESTRUCTIVE_TOOLS=false
# MAX_OUTPUT_TOKENS: trần output token cho MỖI lần gọi LLM của luồng chat.
# 0 = không giới hạn (câu trả lời có thể dài 15K+ ký tự và mất 40+ giây).
# Khi chạm trần, UI hiện chỉ báo bị cắt + nút "Tiếp tục".
MAX_OUTPUT_TOKENS=8192

# ── Vận hành ─────────────────────────────────────────────────────────────────
# CHAT_CACHE_VERSION nằm trong chat cache key — BUMP giá trị này sau khi đổi
# model bên Go agent hoặc đổi system prompt, vì BFF không tự biết model bên Go
# nên cache sẽ không tự làm mới.
CHAT_CACHE_VERSION=1
# CORS_ORIGIN: danh sách origin phân tách bằng dấu phẩy
CORS_ORIGIN=https://your-domain.com

# ── LangSmith tracing (tùy chọn) ─────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-agent-tut
LANGSMITH_API_KEY=lsv2_...

# ── MinIO / S3 (object storage) ──────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-in-production
S3_BUCKET=jarvis-uploads
S3_REGION=us-east-1
