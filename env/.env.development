# =============================================================================
# J.A.R.V.I.S. — Development Environment (committed, safe defaults)
# =============================================================================
# Dùng cho local dev: pnpm dev
# Docker Compose dev cũng đọc file này qua env_file.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.xxx.mongodb.net/ai_agent_tut

# PostgreSQL (Docker container — docker/development/)
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_dev
POSTGRES_DB=ai_agent_tut
PG_CONNECTION_STRING=postgresql://jarvis:jarvis_dev@localhost:5432/ai_agent_tut

# Redis (Docker container — docker/development/)
REDIS_URL=redis://localhost:6379/0

# ── AI Provider: Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── AI Provider: Google (primary) ─────────────────────────────────────────────
LLM_PROVIDER=auto
GOOGLE_API_KEY=AIza...
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_SECONDARY_MODEL=gemini-3.5-flash-lite
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_THINKING_LEVEL=LOW

# ── AI Provider: DeepSeek (cheap immediate fallback) ──────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# ── Embedding ────────────────────────────────────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── Auth: JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-not-for-production-12345678
JWT_REFRESH_SECRET=dev-refresh-secret-not-for-production-12345

# ── Auth: Google OAuth ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── Agent Backend ────────────────────────────────────────────────────────────
AGENT_BACKEND=langgraph
AGENT_GO_URL=http://localhost:3002
AGENT_GO_TIMEOUT=120000

# ── Go Agent (services/agent-go) ─────────────────────────────────────────────
# PORT=3002 (Go agent dùng port riêng — set khi chạy Go agent)
GEMINI_GO_PORT=3002
# SQLite
JARVIS_DB_PATH=jarvis.db
JARVIS_SKILLS_DIR=./skills
# Embedding (Go agent fallback)
EMBED_MODEL=nomic-embed-text
MONGODB_DB=ai_agent_tut

# ── Vận hành ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=

# ── LangSmith tracing (tùy chọn) ─────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-agent-tut
LANGSMITH_API_KEY=lsv2_...

# ── MinIO / S3 (object storage: ảnh, doc, file agent) ─────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=jarvis-uploads
S3_REGION=us-east-1
