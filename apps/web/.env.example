# =============================================================================
# React SPA (Vite) — Environment Variables
# =============================================================================
# Copy: cp .env.example .env
# Chỉ biến có tiền tố VITE_ mới được expose vào bundle client.
# CẢNH BÁO: không đặt secret ở đây — mọi giá trị VITE_* đều public trong bundle.

# ----- Go Agent Runtime -----
# Base URL cho các endpoint gọi trực tiếp Go agent (vd GET /suggestions).
# Dev: http://localhost:3002
# Docker (nginx proxy /suggestions -> agent-go): để trống dùng same-origin.
VITE_AGENT_URL=http://localhost:3002
