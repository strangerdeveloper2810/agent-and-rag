# =============================================================================
# Fastify API Gateway — Environment Variables
# =============================================================================
# Copy: cp .env.example .env

# ----- Server -----
PORT=3001
NODE_ENV=development

# ----- Database -----
MONGODB_URI=mongodb+srv://user:pass@cluster.xxx.mongodb.net/ai_agent_tut

# ----- AI Provider: Anthropic (dùng cho LangGraph in-process) -----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ----- AI Provider: Google (optional, chọn LLM_PROVIDER=google để dùng) -----
# Lấy key tại https://aistudio.google.com/apikey
LLM_PROVIDER=anthropic
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-3.1-flash-lite
# Mức "thinking" của Gemini 3.x: OFF | LOW | MEDIUM | HIGH.
# Gemini 3.x bật thinking mặc định -> mỗi lượt tốn 30-60s dù câu trả lời ngắn.
# LOW = nhanh nhất (khuyến nghị cho agent gọi tool). Đặt OFF nếu model không hỗ trợ thinking.
GOOGLE_THINKING_LEVEL=LOW

# ----- Embedding -----
# Lấy key free tại https://voyageai.com (3 req/phút miễn phí).
VOYAGE_API_KEY=pa-...

# ----- Agent Backend -----
# "langgraph" = in-process LangChain (legacy).
# "go" = proxy HTTP+SSE sang service agent-go (khuyến nghị cho production).
AGENT_BACKEND=langgraph

# Chỉ dùng khi AGENT_BACKEND=go.
# URL gốc của Go agent runtime (mặc định: http://localhost:3002).
AGENT_GO_URL=http://localhost:3002
# Timeout (ms) cho mỗi HTTP request sang Go agent (mặc định: 120000 = 2 phút).
AGENT_GO_TIMEOUT=120000

# ----- Vận hành -----
# CORS_ORIGIN: danh sách origin phân tách bằng dấu phẩy (vd http://localhost:3000).
# Rỗng = mọi origin (chỉ nên dùng ở dev).
CORS_ORIGIN=

# ----- LangSmith tracing (tùy chọn) -----
# Visualize agent graph: node, token, tool call, latency.
# Lấy key free tại https://smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-agent-tut
LANGSMITH_API_KEY=lsv2_...
