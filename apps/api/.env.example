PORT=3001
MONGODB_URI=mongodb+srv://user:pass@cluster.xxx.mongodb.net/ai_agent_tut
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Chọn nhà cung cấp model cho agent: "anthropic" (mặc định) hoặc "google".
# Nếu dùng google → BẮT BUỘC có GOOGLE_API_KEY (lấy tại https://aistudio.google.com/apikey).
LLM_PROVIDER=anthropic
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-3.1-flash-lite
# Mức "thinking" của Gemini 3.x: OFF | LOW | MEDIUM | HIGH.
# Gemini 3.x bật thinking mặc định → mỗi lượt tốn 30-60s dù câu trả lời ngắn.
# LOW = nhanh nhất (khuyến nghị cho agent gọi tool). Đặt OFF nếu model không hỗ trợ thinking.
GOOGLE_THINKING_LEVEL=LOW

# Backend chạy agent: "langgraph" (in-process, mặc định) | "go" (proxy sang service agent-go, P12).
AGENT_BACKEND=langgraph

# Vận hành
NODE_ENV=development
# CORS: danh sách origin phân tách bằng dấu phẩy (vd http://localhost:3000). Rỗng = mọi origin (dev).
CORS_ORIGIN=

# LangSmith tracing (tùy chọn) — visualize graph chạy: node, token, tool call, latency.
# Lấy key free tại https://smith.langchain.com → Settings → API Keys.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-agent-tut
LANGSMITH_API_KEY=lsv2_...
